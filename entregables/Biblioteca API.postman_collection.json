      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();\r\n\r\nif (pm.response.code === 200 && respuesta.data && respuesta.data.token) {\r\n    pm.environment.set(\"token\", respuesta.data.token);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"admin@biblioteca.test\",\r\n    \"password\": \"password\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
